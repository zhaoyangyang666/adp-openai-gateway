# ADP OpenAI Gateway 配置文件
# 复制此文件为 .env 并填入实际值

# ========== 腾讯云凭证 ==========
# 从 https://console.cloud.tencent.com/cam/capi 获取
SECRET_ID="your_secret_id"
SECRET_KEY="your_secret_key"

# ========== ADP 智能体配置 ==========
# 从 ADP 控制台获取智能体的 BotAppKey
ADP_BOT_APP_KEY="your_bot_app_key"

# ========== 网关鉴权 ==========
# 管理页面（/admin）登录密码，用于分配管理各同事的 API Key
ADMIN_PASSWORD=""

# ========== 模型白名单 ==========
# ADP 空间 ID（与运营端《智能体管理》绑定平台为同一口径）
# 留空则使用内置静态模型清单（官方 Claw 可换模型）
ADP_SPACE_ID=""
# ADP 管理 API 地域，默认 ap-guangzhou
ADP_REGION="ap-guangzhou"

# ========== 服务配置 ==========
PORT=3100
HOST=127.0.0.1
